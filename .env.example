# Nur für die öffentliche Demo (JOBPILOT_DEMO=1): gemeinsamer Key des Servers.
# In der normalen App hinterlegt jeder Nutzer seinen eigenen Key in den Einstellungen.
ANTHROPIC_API_KEY=

# Supabase-Anmeldung in der App; die URL und den öffentlichen Key nutzt auch der Server, um die
# Anfrage mit dem Bearer-Token des Nutzers auszuführen. Ein Servergeheimnis ist nicht nötig.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
