# KI-Anbieter: "anthropic" (Standard) oder "openai"
AI_PROVIDER=anthropic

# Nur für die öffentliche Demo (JOBPILOT_DEMO=1): gemeinsamer Key des Servers.
# In der normalen App hinterlegt jeder Nutzer seinen eigenen Key in den Einstellungen.
ANTHROPIC_API_KEY=

# OpenAI oder ein OpenAI-kompatibler Dienst: ebenfalls nur als Server-Key für die Demo
OPENAI_API_KEY=
# Modell für OpenAI; muss Structured Outputs unterstützen
OPENAI_MODEL=gpt-6-astra
# Optional: anderer Endpunkt, z. B. ein OpenAI-kompatibler Anbieter oder ein Gateway
# OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase-Anmeldung in der App; die URL und den öffentlichen Key nutzt auch der Server, um die
# Anfrage mit dem Bearer-Token des Nutzers auszuführen. Ein Servergeheimnis ist nicht nötig.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
